# Base Point — environment variables (example).
#
# Copy this file to `.env.local` and fill in any values you need. None of
# these are required for the Base Pay path to work; they only affect the
# wallet path.

# --- WalletConnect ---------------------------------------------------------
# Optional. If set, the wallet payment path includes a WalletConnect
# connector so customers can scan a QR with mobile wallets that support
# WalletConnect (Rainbow, Trust, etc.). Get a project id from
# https://cloud.reown.com/.
#
# If unset, the WalletConnect connector is simply omitted at build time
# and the rest of the wallet path (injected wallets like MetaMask/Rabby
# and Coinbase Wallet) still works.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- Supabase (cross-device checkout) --------------------------------------
# Optional. When both vars are set, payment requests are stored in
# Supabase so QR checkout links work across devices. Without these,
# Base Point runs in localStorage-only mode (demo/single-device).
#
# 1. Create a Supabase project at https://supabase.com/dashboard
# 2. Run the SQL migration below in the SQL Editor
# 3. Copy your project URL and anon key here
#
# SQL schema for the `payment_requests` table:
#
#   create table payment_requests (
#     id text primary key,
#     receipt_id text unique,
#     recipient text not null,
#     amount_usdc text not null,
#     note text not null default '',
#     status text not null default 'pending',
#     payment_id text,
#     paid_via text,
#     error_message text,
#     network text not null default 'base',
#     chain_id integer not null default 8453,
#     created_at text not null,
#     submitted_at text,
#     settled_at text,
#     merchant_name text,
#     item_name text,
#     quantity integer,
#     unit_price_usdc text,
#     customer_label text,
#     receipt_url text
#   );
#
#   -- Optional: enable Row Level Security (no auth in MVP, so allow all)
#   alter table payment_requests enable row level security;
#   create policy "Allow all access" on payment_requests
#     for all using (true) with check (true);
#
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
